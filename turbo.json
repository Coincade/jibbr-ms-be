{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "concurrency": "15",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "JWT_SECRET",
    "RATE_LIMIT_MAX",
    "RATE_LIMIT_WINDOW_MS",
    "DATABASE_URL",
    "REDIS_URL",
    "INTERNAL_SERVICE_SECRET",
    "ALLOWED_ORIGINS",
    "JIBBR_DESKTOP_LATEST_VERSION",
    "JIBBR_DESKTOP_MIN_VERSION",
    "JIBBR_DESKTOP_UPDATE_URL",
    "JIBBR_DESKTOP_FORCE_UPDATE",
    "JIBBR_DESKTOP_REQUIRE_VERSION",
    "JIBBR_MOBILE_LATEST_VERSION",
    "JIBBR_MOBILE_MIN_VERSION",
    "JIBBR_MOBILE_UPDATE_URL",
    "JIBBR_MOBILE_FORCE_UPDATE",
    "JIBBR_MOBILE_REQUIRE_VERSION",
    "JIBBR_WEB_LATEST_VERSION",
    "JIBBR_WEB_MIN_VERSION",
    "JIBBR_WEB_UPDATE_URL",
    "JIBBR_WEB_FORCE_UPDATE",
    "JIBBR_WEB_REQUIRE_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "NODE_ENV", "INTERNAL_SERVICE_SECRET"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "NODE_ENV", "INTERNAL_SERVICE_SECRET"]
    },
    "test:unit": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "NODE_ENV", "INTERNAL_SERVICE_SECRET"]
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
