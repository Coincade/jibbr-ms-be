{
  "name": "call-service",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node ./dist/index.js",
    "server": "nodemon ./dist/index.js",
    "watch": "tsc -w",
    "dev": "concurrently \"npm run watch\" \"npm run server\"",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "cd ../../packages/database && npm run db:generate"
  },
  "dependencies": {
    "@jibbr/auth-middleware": "*",
    "@jibbr/database": "*",
    "@jibbr/logger": "*",
    "@jibbr/shared-types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.11.0",
    "mediasoup": "^3.15.2",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.3"
  }
}
